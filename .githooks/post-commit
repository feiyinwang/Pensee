#!/usr/bin/env bash
set -uo pipefail

if [ -n "${WRITER_SKIP_AUTOBUILD:-}" ]; then
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"

if [ -d "$ROOT/.git/rebase-merge" ] || [ -d "$ROOT/.git/rebase-apply" ]; then
  exit 0
fi

BRANCH="$(git rev-parse --abbrev-ref HEAD)"
case "$BRANCH" in
  mine|mine/*) ;;
  *)
    echo "[post-commit] branch '$BRANCH' is not a personal branch - skipping auto-build"
    exit 0
    ;;
esac

nohup "$ROOT/scripts/ship-local.sh" >/tmp/writer-ship-local.log 2>&1 &
echo "[post-commit] build started in background - tail -f /tmp/writer-ship-local.log"
exit 0
