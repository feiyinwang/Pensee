#!/usr/bin/env sh
# After a commit that changes the app, rebuild it in the background and open
# the new build from /Applications. PENSEE_SKIP_AUTOBUILD=1 skips it.
[ -n "${PENSEE_SKIP_AUTOBUILD:-}" ] && exit 0

# Only the main checkout: a worktree's branch isn't the app the user runs.
GIT_DIR_ABS=$(git rev-parse --absolute-git-dir)
[ "$GIT_DIR_ABS" = "$(git rev-parse --path-format=absolute --git-common-dir)" ] || exit 0
if [ -d "$GIT_DIR_ABS/rebase-merge" ] || [ -d "$GIT_DIR_ABS/rebase-apply" ]; then exit 0; fi

# The build is made from apps/desktop/ (not its tests or prototypes) and
# embeds CHANGELOG.md.
git diff --quiet HEAD^ HEAD -- apps/desktop CHANGELOG.md ':(exclude)apps/desktop/e2e' \
  ':(exclude)apps/desktop/tests' ':(exclude)apps/desktop/proto' 2>/dev/null && exit 0

ROOT=$(git rev-parse --show-toplevel)
unset GIT_DIR GIT_INDEX_FILE GIT_PREFIX GIT_WORK_TREE
# Appends: a run that finds a build going leaves its line in the same log.
nohup "$ROOT/scripts/ship-local.sh" >>/tmp/pensee-ship-local.log 2>&1 &
echo "[post-commit] rebuilding the app in the background - tail -f /tmp/pensee-ship-local.log"
exit 0
